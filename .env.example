# =============================================================================
# CaseLink — copy to .env.local for local development.
# Vercel: Project Settings → Environment Variables (set per environment).
# Never commit .env.local or real secrets.
# =============================================================================

# --- Public (embedded in the client bundle) ---
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical origin for auth redirects (sign-up, password reset). Prefer over NEXT_PUBLIC_APP_URL.
# NEXT_PUBLIC_SITE_URL=https://your-app.example

# Required production launch posture. A production build/runtime refuses unsafe values.
# CASELINK_TENANCY_MODE=single-tenant
# CASELINK_INVITE_ONLY=1
# CASELINK_HSTS=1
# CASELINK_ENVIRONMENT=production
# Non-secret approved production project origin, required in BOTH hosted environments.
# Production must match it; Preview must use a separate synthetic project.
# CASELINK_PRODUCTION_SUPABASE_URL=https://approved-production-project.supabase.co

# Legacy alias for site URL (optional if NEXT_PUBLIC_SITE_URL is set).
# NEXT_PUBLIC_APP_URL=https://your-app.example

# --- Server-only (never NEXT_PUBLIC_* or browser code) ---
# Required only in a protected operator job. Hosted web builds reject admin credentials.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (required in production for plan generation and text assistance).
# OPENAI_API_KEY=

# Optional model overrides (validated at startup; see src/lib/ai/model-allowlist.ts).
# OPENAI_PLAN_GENERATION_MODEL=gpt-6.1-sol
# OPENAI_PLAN_GENERATION_REASONING_EFFORT=medium
# OPENAI_PLAN_GENERATION_MAX_OUTPUT_TOKENS=16384
# OPENAI_PLAN_REFINEMENT_MODEL=gpt-6.1-sol
# OPENAI_PLAN_REFINEMENT_REASONING_EFFORT=medium
# OPENAI_PLAN_REFINEMENT_MAX_OUTPUT_TOKENS=8192
# OPENAI_STEP_REFINEMENT_MODEL=gpt-6-luna
# OPENAI_STEP_REFINEMENT_REASONING_EFFORT=low
# OPENAI_STEP_REFINEMENT_MAX_OUTPUT_TOKENS=4096
# OPENAI_CASE_ASSISTANT_MODEL=gpt-6.1-sol
# OPENAI_CASE_ASSISTANT_REASONING_EFFORT=medium
# OPENAI_CASE_ASSISTANT_MAX_OUTPUT_TOKENS=8192
# Legacy OPENAI_UI_MODEL and OPENAI_PLAN_PHASE_MODEL remain supported.
# OPENAI_MODEL_OVERRIDE=
# Additional task-specific overrides exist in src/lib/env.ts (e.g. OPENAI_PLAN_PHASE_MODEL).

# Shared cost and abuse guardrails are enforced atomically by the database migration.
# OPENAI_MAX_INPUT_CHARS=120000
# OPENAI_MAX_OUTPUT_TOKENS=32768

# Development-only diagnostics. Production startup rejects these when enabled.
# OPENAI_DEBUG=1
# OPENAI_PAYLOAD_DEBUG=1
# PLAN_REGENERATE_DEBUG=1
# PLAN_REFINE_DEBUG=1
