  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The shared violet action with a soft action shadow and clear focus.",
      "html": "<button class=\"ds-primary\">Save and continue</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;min-height:48px;border-radius:var(--radius-control);padding:.75rem 1.2rem;font:650 .9375rem/1.4 var(--font-body);border:1px solid transparent;cursor:pointer;transition:background 160ms ease,border-color 160ms ease;text-decoration:none;background:var(--color-accent);color:#fff;box-shadow:var(--shadow-action)}.ds-primary:hover{background:var(--color-accent-hover)}.ds-primary:focus-visible{outline:3px solid var(--color-focus);outline-offset:4px}.ds-primary:disabled{cursor:wait;opacity:.65}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A surfaced action with a strong boundary and pale hover.",
      "html": "<button class=\"ds-secondary\">Download summary</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;min-height:48px;border-radius:var(--radius-control);padding:.75rem 1.2rem;font:650 .9375rem/1.4 var(--font-body);border:1px solid transparent;cursor:pointer;transition:background 160ms ease,border-color 160ms ease;text-decoration:none;background:var(--color-surface);color:var(--color-ink);border-color:var(--color-rule-strong)}.ds-secondary:hover{background:var(--color-accent-soft)}.ds-secondary:focus-visible{outline:3px solid var(--color-focus);outline-offset:4px}.ds-secondary:disabled{cursor:wait;opacity:.65}"
    },
    {
      "name": "Quiet action",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Underlined violet action without a filled surface.",
      "html": "<button class=\"ds-quiet\">Back</button>",
      "css": ".ds-quiet{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;min-height:48px;border-radius:var(--radius-control);padding:.75rem 1.2rem;font:650 .9375rem/1.4 var(--font-body);border:1px solid transparent;cursor:pointer;transition:background 160ms ease,border-color 160ms ease;text-decoration:none;background:transparent;color:var(--color-accent);padding-left:.3rem;padding-right:.3rem;text-decoration:underline;text-underline-offset:4px}.ds-quiet:hover{color:var(--color-accent-hover)}.ds-quiet:focus-visible{outline:3px solid var(--color-focus);outline-offset:4px}.ds-quiet:disabled{cursor:wait;opacity:.65}"
    },
    {
      "name": "Destructive action",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Error-colored text and boundary distinguish the destructive choice.",
      "html": "<button class=\"ds-danger\">Stop future work</button>",
      "css": ".ds-danger{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;min-height:48px;border-radius:var(--radius-control);padding:.75rem 1.2rem;font:650 .9375rem/1.4 var(--font-body);border:1px solid transparent;cursor:pointer;transition:background 160ms ease,border-color 160ms ease;text-decoration:none;color:var(--color-error);border-color:var(--color-error-rule);background:var(--color-surface)}.ds-danger:hover{background:var(--color-error-bg)}.ds-danger:focus-visible{outline:3px solid var(--color-focus);outline-offset:4px}.ds-danger:disabled{cursor:wait;opacity:.65}"
    },
    {
      "name": "Factual input",
      "kind": "input",
      "refersTo": "input",
      "description": "Readable body-sized entry with a visible label and strong boundary.",
      "html": "<label class=\"ds-label\" for=\"ds-zip\">Household ZIP code</label><input class=\"ds-input\" id=\"ds-zip\" value=\"19104\" inputmode=\"numeric\">",
      "css": ".ds-label{display:block;margin-bottom:.45rem;color:var(--color-ink);font:600 .9375rem/1.6 var(--font-body)}.ds-input{display:block;width:100%;min-height:48px;border:1px solid var(--color-rule-strong);border-radius:var(--radius-control);background:var(--color-surface);padding:.7rem .8rem;color:var(--color-ink);font:1rem/1.5 var(--font-body)}.ds-input::placeholder{color:var(--color-ink-faint)}.ds-input[aria-invalid=\"true\"]{border-color:var(--color-error)}.ds-input:focus-visible{outline:3px solid var(--color-focus);outline-offset:4px}"
    },
    {
      "name": "Task surface",
      "kind": "card",
      "refersTo": "task-surface",
      "description": "A flat near-white workspace with a lavender boundary and serif heading.",
      "html": "<section class=\"ds-surface\"><h2>What happens next</h2><p>Your support paths keep their separate recorded outcomes.</p></section>",
      "css": ".ds-surface{background:var(--color-surface);border:1px solid var(--color-rule);border-radius:var(--radius-feature);padding:2rem;color:var(--color-ink);font:1rem/1.6 var(--font-body)}.ds-surface h2{margin:0 0 1rem;font:560 1.3rem/1.15 var(--font-display);letter-spacing:-.03em}.ds-surface p{margin:0;color:var(--color-ink-muted)}"
    },
    {
      "name": "Outcome badge",
      "kind": "chip",
      "refersTo": "outcome-badge",
      "description": "A text-labeled state, with quiet waiting and semantic attention variants.",
      "html": "<span class=\"ds-badge\">Prepared</span><span class=\"ds-badge ds-wait\">Waiting for a connection</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:.35rem;margin:.25rem;background:var(--color-accent-soft);color:var(--color-accent);border-radius:999px;padding:.3rem .65rem;font:650 .75rem/1.6 var(--font-body);white-space:normal}.ds-badge.ds-wait{background:var(--color-paper-2);color:var(--color-ink-muted)}"
    },
    {
      "name": "Direct navigation",
      "kind": "nav",
      "description": "Geist task links with an explicit current page and violet interaction.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Parent\"><a href=\"#support\" aria-current=\"page\">My support</a><a href=\"#help\">Help</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:1.8rem;font:600 .9rem/1.6 var(--font-body)}.ds-nav a{color:var(--color-ink-muted);text-decoration:none}.ds-nav a:hover,.ds-nav a[aria-current=\"page\"]{color:var(--color-accent)}.ds-nav a:focus-visible{outline:3px solid var(--color-focus);outline-offset:4px}"
    },
