      "html": "<span class=\"ds-brand\"><svg viewBox=\"0 0 40 40\" width=\"40\" height=\"40\" aria-hidden=\"true\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m17 15 4-4a6.36 6.36 0 0 1 9 9l-4 4a6.36 6.36 0 0 1-9 0\"/><path d=\"m23 25-4 4a6.36 6.36 0 0 1-9-9l4-4a6.36 6.36 0 0 1 9 0\"/></g></svg><span>CaseLink</span></span>",
      "css": ".ds-brand{display:inline-flex;align-items:center;gap:.75rem;color:var(--color-ink);font:560 1.75rem/1 var(--font-display);letter-spacing:-.025em}.ds-brand svg{flex:none;color:var(--color-accent)}"
    },
    {
      "name": "Public support entry",
      "kind": "custom",
      "description": "Two routes within one shared surface; desktop columns become phone rows.",
      "html": "<div class=\"ds-services\"><a href=\"#food\"><strong>Food & benefits</strong><span>Food today, SNAP and WIC.</span></a><a href=\"#utilities\"><strong>Help with utility bills</strong><span>Electricity, gas and water.</span></a></div>",
      "css": ".ds-services{display:grid;grid-template-columns:1fr 1fr;padding:1.6rem 2rem;background:var(--color-surface);border:1px solid var(--color-rule);border-radius:var(--radius-feature);font:1rem/1.6 var(--font-body)}.ds-services a{display:block;padding:.5rem 1.75rem .5rem 0;text-decoration:none;color:var(--color-ink)}.ds-services a+a{padding:.5rem 0 .5rem 1.75rem;border-left:1px solid var(--color-rule)}.ds-services strong{display:block;font-weight:650;font-size:1.125rem;line-height:1.35;letter-spacing:-.02em}.ds-services span{display:block;margin-top:.4rem;font-size:.875rem;color:var(--color-ink-muted)}.ds-services a:hover strong{color:var(--color-accent)}.ds-services a:focus-visible{outline:3px solid var(--color-focus);outline-offset:4px}@media(max-width:760px){.ds-services{grid-template-columns:1fr;padding:.25rem 1.25rem}.ds-services a,.ds-services a+a{padding:1.25rem 0;border-left:0}.ds-services a+a{border-top:1px solid var(--color-rule)}}"
    }
