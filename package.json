{
  "name": "homelessness-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "esbuild": "0.27.2",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "test": "NODE_ENV=test vitest",
    "test:run": "NODE_ENV=test vitest run",
    "test:db-security": "tsx scripts/test-database-security.ts",
    "typecheck": "tsc --noEmit",
    "verify:lockfile": "node scripts/verify-deploy-lockfiles.mjs",
    "verify:resource-seed": "tsx scripts/verify-resource-seed-paths.ts",
    "verify:secrets": "node scripts/scan-tracked-secrets.mjs",
    "verify": "npm run verify:lockfile && npm run verify:resource-seed && npm run verify:secrets && npm run typecheck && npm run lint && npm run test:run && npm run build",
    "ci": "npm run verify",
    "db:import": "tsx scripts/import-resources.ts",
    "db:invite-user": "tsx scripts/invite-user.ts",
    "db:create-test-user": "tsx scripts/create-test-user.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "geist": "^1.7.2",
    "iconoir-react": "^7.11.1",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^7",
    "vitest": "^4.1.10"
  }
