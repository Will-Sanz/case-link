# Parent WEB runtime only. Copy to a private environment file; never reuse school credentials.
CASELINK_PRODUCT=parent
CASELINK_ENVIRONMENT=test
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3200
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_local_parent_key
CASELINK_PARENT_REAL_DATA_APPROVED=0

# Hosted environments additionally need exact HTTPS origins, HSTS, isolated projects,
# database processing approval and the Auth hook. See docs/parent-support-runtime.md.
# CASELINK_SCHOOL_SUPABASE_URL=https://school-project.supabase.co
# CASELINK_PARENT_PRODUCTION_SUPABASE_URL=https://parent-production.supabase.co
# CASELINK_HSTS=1

# Do not put database, storage-admin, broker, email or OpenAI secrets in this web file.
# The separate protected worker/broker/retention settings are documented in the runbook.
